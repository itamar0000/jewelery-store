# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# Next.js build output
/.next/
/out/
next-env.d.ts

# Production
/build

# Testing
/coverage

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Prisma generated client (regenerated by `npm run db:generate`, and on install)
/src/generated/

# Local editor/agent tooling (dev server launch config, session state)
.claude/

# Generated image drafts awaiting review. Never committed: they are raw model
# output, and only files promoted through scripts/prepare-editorial.ts belong
# in public/.
/.editorial-drafts/

# Impeccable decision-page state: a running server's scratch, not source.
.impeccable/questions/

# Impeccable inspection captures: build evidence, regenerated on demand.
.impeccable/review/
photo-kit/

# Local admin sign-in for development (scripts/admin-user.ts), never committed
.admin-local.txt
