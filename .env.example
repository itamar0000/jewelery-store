# ---------------------------------------------------------------------------
# Environment variable template.
#
# Copy to `.env.local` for local development. `.env*` is git-ignored except for
# this file; never put a real secret in here.
#
# Phase 0 CONSUMES NONE OF THESE. There is no environment module yet — it is
# Phase 1 work (`src/lib/env.ts`, a zod schema that fails fast at boot,
# ARCHITECTURE §14). The names below are recorded so the shape of configuration
# is visible from the start, not because anything reads them today.
# ---------------------------------------------------------------------------

# --- Phase 1: database (PostgreSQL + Prisma) -------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jewelry?schema=public
# Unpooled connection used by `prisma migrate`. In production these differ;
# locally they are the same (ARCHITECTURE §5).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/jewelry?schema=public

# --- Phase 2/5: authentication (Auth.js) -----------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Phase 6b: payment provider (PROVIDER NOT CHOSEN — TBD.md B1) ----------
# Names are intentionally provider-neutral. No SDK is installed.
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Phase 6b: invoicing provider (PROVIDER NOT CHOSEN — TBD.md B2) --------
INVOICE_API_KEY=

# --- Phase 6b: email provider (PROVIDER NOT CHOSEN — TBD.md I2) ------------
EMAIL_API_KEY=
EMAIL_FROM=

# --- Phase 2: object storage (PROVIDER NOT CHOSEN — TBD.md I1) -------------
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Phase 9: public site configuration ------------------------------------
# Canonical origin, used for sitemap/robots/canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
