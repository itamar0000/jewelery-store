# ---------------------------------------------------------------------------
# Environment variable template.
#
# Copy to `.env` for local development:
#
#     cp .env.example .env
#
# `.env*` is git-ignored except for this file. NEVER put a real secret here.
#
# Every variable below is declared in the schema at src/lib/env/schema.ts and
# is validated at startup. Adding a variable here without adding it there means
# nothing reads it; adding it there without a default means the application
# refuses to start until it is set.
#
# Payment, invoicing, email and object-storage credentials are deliberately
# ABSENT. No provider has been chosen (TBD.md B1, B2, I1, I2) and no code reads
# them, so listing placeholder keys would only describe integrations that do
# not exist.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. REQUIRED - there is no default, because a
# fallback would silently point a misconfigured deployment at the wrong
# database.
#
# The value below matches docker-compose.yml, so `npm run db:up` plus this file
# is a working local setup. These are development-only credentials.
DATABASE_URL="postgresql://jewelry:jewelry_local_dev@localhost:5433/jewelry?schema=public"

# Unpooled connection, used ONLY by the Prisma CLI (migrate, studio, the
# scripts/ tools). OPTIONAL everywhere, including production.
#
# Background: `prisma migrate deploy` holds a session-level advisory lock, and
# a pooled endpoint - PgBouncer in transaction mode - has no stable session to
# hold it, so migrating through one fails with
#
#   Error: P1002 ... Timed out trying to acquire a postgres advisory lock
#
# On Neon, DATABASE_URL is normally the POOLED endpoint (host ends `-pooler`),
# which is correct for the application because serverless functions need
# pooling. prisma.config.ts derives the direct endpoint from it automatically
# by dropping that suffix, so Neon deployments need nothing set here.
#
# Set this only to override that: a non-Neon pooler, or a host whose direct
# endpoint is not simply the pooled name minus `-pooler`.
#
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Canonical public origin: canonical URLs, sitemap, robots, Open Graph images.
# Optional - defaults to http://localhost:3000. The production domain is TBD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Whether the catalogue's prices are final. OPTIONAL, defaults to false: while
# false, the storefront labels prices as estimates ("מחיר משוער" beside a price,
# "המחירים משוערים" once per grid). Set to exactly "true" once real prices are in.
#
# PRICES_FINAL="false"

# ------------------------------------------------------------------- contact
#
# The business's contact channels. ALL OPTIONAL, and nothing is defaulted: with
# none set, the site invites no contact at all (no nav item, no footer column,
# no product-page prompt) and /contact returns 404. Set only real details.
#
#   CONTACT_WHATSAPP  number in international form: country code + number, digits
#                     only (spaces, dashes and a leading + are accepted)
#   CONTACT_PHONE     shown exactly as written; digits, spaces, dashes, ( ) and +
#   CONTACT_EMAIL     an email address
#
# CONTACT_WHATSAPP=""
# CONTACT_PHONE=""
# CONTACT_EMAIL=""

# ---------------------------------------------------------------------- VAT
#
# The VAT rate, in basis points (1800 = 18%). OPTIONAL and never defaulted: the
# rate and the business's VAT registration are the owner's facts (TBD B21).
# Catalogue prices include VAT either way; this only decides whether the cart,
# the checkout and each order STATE the VAT inside the total. Every order
# records the rate in force when it was placed, so changing this later never
# rewrites a past order.
#
# VAT_RATE_BPS=""

# --------------------------------------------------------------------- media
#
# Media storage is S3-compatible: Cloudflare R2 in production, MinIO locally
# (docs/MEDIA_STORAGE_DECISION.md).
#
# ALL SIX ARE OPTIONAL. With none of them set the application boots, the
# catalog renders, and images fall back to the placeholder surface. Set either
# all six or none - a partial configuration is a deployment mistake and is
# rejected loudly rather than treated as "unconfigured".
#
# The values below match the MinIO service in docker-compose.yml. To use them:
#   npm run media:up && npm run media:init
#
# MEDIA_S3_ENDPOINT="http://localhost:9000"
# MEDIA_S3_REGION="us-east-1"
# MEDIA_S3_BUCKET="jewelry-media"
# MEDIA_S3_ACCESS_KEY_ID="jewelry_dev"
# MEDIA_S3_SECRET_ACCESS_KEY="jewelry_local_dev"
# MEDIA_PUBLIC_BASE_URL="http://localhost:9000/jewelry-media"
